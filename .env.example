# ─── Web Push (VAPID) ────────────────────────────────────────
# Generate a fresh pair before going live:
#   npx web-push generate-vapid-keys
# Public key must be exposed to the client → muss mit NEXT_PUBLIC_ anfangen.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Same value as VAPID_PUBLIC_KEY, just exposed to the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Persistenz ──────────────────────────────────────────────
# Auf Railway: persistentes Volume bei /data mounten
DATA_DIR=./data

# ─── Port (Railway setzt das automatisch) ────────────────────
# PORT=3000
